generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaAsset {
  id        String   @id
  publicId  String   @unique
  url       String
  width     Int
  height    Int
  format    String
  bytes     Int
  alt       String   @default("")
  folder    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
}

model SitePage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  eyebrow         String   @default("")
  excerpt         String   @default("")
  body            String   @default("")
  pageType        String   @default("page")
  isPublished     Boolean  @default(true)
  metaTitle       String   @default("")
  metaDescription String   @default("")
  keywords        String   @default("")
  ogImage         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pageType])
  @@index([isPublished])
}

model Category {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  eyebrow         String            @default("")
  description     String            @default("")
  collectionType  String            @default("main")
  ageRange        String            @default("")
  imageUrl        String            @default("")
  isPublished     Boolean           @default(true)
  sortOrder       Int               @default(0)
  metaTitle       String            @default("")
  metaDescription String            @default("")
  keywords        String            @default("")
  ogImage         String            @default("")
  products        ProductCategory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([collectionType])
  @@index([sortOrder])
  @@index([isPublished])
}

model Banner {
  id              String    @id @default(cuid())
  title           String
  subtitle        String    @default("")
  ctaLabel        String    @default("")
  ctaHref         String    @default("")
  desktopImage    String    @default("")
  mobileImage     String    @default("")
  scope           String    @default("home")
  placement       String    @default("hero")
  presentation    String    @default("cover")
  textAlignment   String    @default("left")
  targetSlug      String    @default("")
  isEnabled       Boolean   @default(true)
  sortOrder       Int       @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  metaTitle       String    @default("")
  metaDescription String    @default("")
  keywords        String    @default("")
  ogImage         String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([scope, targetSlug])
  @@index([isEnabled])
  @@index([sortOrder])
}

model GalleryImage {
  id         String   @id @default(cuid())
  title      String   @default("")
  imageUrl   String
  alt        String   @default("")
  scope      String   @default("lifestyle")
  targetSlug String   @default("")
  isFeatured Boolean  @default(false)
  isEnabled  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scope, targetSlug])
  @@index([isFeatured])
  @@index([sortOrder])
}

model Product {
  id                String                    @id @default(cuid())
  slug              String                    @unique
  name              String
  shortDescription  String                    @default("")
  description       String                    @default("")
  highlights        String                    @default("")
  material          String                    @default("")
  fitDetails        String                    @default("")
  careInstructions  String                    @default("")
  sizeGuide         String                    @default("")
  shippingReturns   String                    @default("")
  price             Int                       @default(0)
  compareAtPrice    Int?
  currency          String                    @default("INR")
  sku               String                    @default("")
  inventory         Int                       @default(0)
  isPublished       Boolean                   @default(true)
  isFeatured        Boolean                   @default(false)
  isNewArrival      Boolean                   @default(false)
  isBestSeller      Boolean                   @default(false)
  isTrending        Boolean                   @default(false)
  isSustainable     Boolean                   @default(false)
  featuredImage     String                    @default("")
  videoUrl          String                    @default("")
  sizes             String                    @default("")
  colors            String                    @default("")
  metaTitle         String                    @default("")
  metaDescription   String                    @default("")
  keywords          String                    @default("")
  ogImage           String                    @default("")
  categories        ProductCategory[]
  images            ProductImage[]
  variants          ProductVariant[]
  sizeGuideRows     ProductSizeGuideRow[]
  colorGuideOptions ProductColorGuideOption[]
  reviews           ProductReview[]
  orderItems        OrderItem[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([isPublished])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@index([isTrending])
  @@index([isSustainable])
}

model ProductSizeGuideRow {
  id        String   @id @default(cuid())
  productId String
  size      String
  ageRange  String   @default("")
  chest     String   @default("")
  waist     String   @default("")
  hip       String   @default("")
  length    String   @default("")
  notes     String   @default("")
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sortOrder])
}

model ProductColorGuideOption {
  id          String   @id @default(cuid())
  productId   String
  name        String
  swatchHex   String   @default("")
  imageUrl    String   @default("")
  description String   @default("")
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([sortOrder])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  sku        String      @unique
  title      String      @default("")
  size       String      @default("")
  color      String      @default("")
  price      Int
  inventory  Int         @default(0)
  weight     Int         @default(0)
  length     Int         @default(0)
  breadth    Int         @default(0)
  height     Int         @default(0)
  isEnabled  Boolean     @default(true)
  sortOrder  Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
  @@index([isEnabled])
  @@index([sortOrder])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  imageUrl   String
  alt        String   @default("")
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([sortOrder])
}

model ProductReview {
  id          String   @id @default(cuid())
  productId   String
  authorName  String
  authorTitle String   @default("")
  rating      Int      @default(5)
  title       String   @default("")
  body        String
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([isPublished])
  @@index([sortOrder])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  shiprocketOrderId String      @default("")
  checkoutOrderId   String      @default("")
  status            String      @default("pending")
  paymentStatus     String      @default("pending")
  paymentMethod     String      @default("")
  currency          String      @default("INR")
  subtotal          Int         @default(0)
  discount          Int         @default(0)
  shipping          Int         @default(0)
  total             Int         @default(0)
  customerName      String      @default("")
  customerEmail     String      @default("")
  customerPhone     String      @default("")
  billingAddress    Json?
  shippingAddress   Json?
  notes             String      @default("")
  rawPayload        Json?
  items             OrderItem[]
  shipment          Shipment?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([checkoutOrderId])
  @@index([shiprocketOrderId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  variantName String          @default("")
  sku         String
  imageUrl    String          @default("")
  quantity    Int
  unitPrice   Int
  total       Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Shipment {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  status               String   @default("draft")
  shiprocketShipmentId String   @default("")
  awbCode              String   @default("")
  courierId            String   @default("")
  courierName          String   @default("")
  pickupStatus         String   @default("")
  trackingUrl          String   @default("")
  rawPayload           Json?
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([awbCode])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventKey    String   @unique
  eventType   String   @default("")
  payload     Json
  processedAt DateTime @default(now())

  @@index([provider])
  @@index([processedAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  quote     String
  rating    Int      @default(5)
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
  @@index([sortOrder])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
